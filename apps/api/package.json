{
  "name": "@beefficient/api",
  "version": "0.1.0",
  "description": "Beefficient backend API",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build && tsc --skipLibCheck database/migrations/*.ts --outDir dist/database/migrations --declaration false --module commonjs --target es2020 && tsc --skipLibCheck data-source.ts --outDir dist --declaration false --module commonjs --target es2020",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typeorm": "typeorm",
    "typeorm:migration:show": "typeorm migration:show -d dist/data-source.js",
    "typeorm:migration:run": "typeorm migration:run -d dist/data-source.js",
    "typeorm:migration:generate": "typeorm migration:generate -d data-source.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --testPathIgnorePatterns \"e2e|integration\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "google-auth-library": "^11.2.0",
    "joi": "^17.11.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
