{
  "name": "@beefficient/web",
  "version": "0.0.1",
  "description": "Frontend web de Beefficient",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vitest": "^1.1.0"
  }
}
